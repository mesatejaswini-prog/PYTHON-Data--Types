ALL DATA TYPES - ONE PROGRAM
a = 10
b = 10.5
c = 2 + 3j
d = True
e = "Python"
f = [1, 2, 3]
g = (1, 2, 3)
h = {1, 2, 3}
i = {"name": "John", "age": 20}
j = None

print(a, type(a))
print(b, type(b))
print(c, type(c))
print(d, type(d))
print(e, type(e))
print(f, type(f))
print(g, type(g))
print(h, type(h))
print(i, type(i))
print(j, type(j))
Output:

10 <class 'int'>
10.5 <class 'float'>
(2+3j) <class 'complex'>
True <class 'bool'>
Python <class 'str'>
[1, 2, 3] <class 'list'>
(1, 2, 3) <class 'tuple'>
{1, 2, 3} <class 'set'>
{'name': 'John', 'age': 20} <class 'dict'>
None <class 'NoneType'>
